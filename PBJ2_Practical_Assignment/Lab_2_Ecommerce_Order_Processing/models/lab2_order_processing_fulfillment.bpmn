<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_OrderProcessing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.5.0">
  <bpmn:process id="Process_EcommerceOrderProcessing" name="Lab 2: End-to-End E-Commerce Order Processing and Fulfilment" isExecutable="true">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Event_OrderReceived" name="Customer Order Placed">
      <bpmn:outgoing>Flow_ToValidateOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Java Spring Boot Job Worker: Validation & Inventory Check -->
    <bpmn:serviceTask id="Activity_ValidateAndCheckInventory" name="Validate Order &amp; Check Inventory">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-order-inventory" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="= orderId" target="orderId" />
          <zeebe:input source="= customerReference" target="customerReference" />
          <zeebe:input source="= customerCategory" target="customerCategory" />
          <zeebe:input source="= productId" target="productId" />
          <zeebe:input source="= quantity" target="quantity" />
          <zeebe:input source="= unitPrice" target="unitPrice" />
          <zeebe:input source="= deliveryPreference" target="deliveryPreference" />
          <zeebe:output source="= orderValid" target="orderValid" />
          <zeebe:output source="= stockStatus" target="stockStatus" />
          <zeebe:output source="= availableStock" target="availableStock" />
          <zeebe:output source="= orderTotal" target="orderTotal" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidateOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_ToStockCheckGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToValidateOrder" sourceRef="Event_OrderReceived" targetRef="Activity_ValidateAndCheckInventory" />
    <bpmn:sequenceFlow id="Flow_ToStockCheckGateway" sourceRef="Activity_ValidateAndCheckInventory" targetRef="Gateway_StockCheck" />

    <!-- Stock Availability Gateway -->
    <bpmn:exclusiveGateway id="Gateway_StockCheck" name="Stock Available?" default="Flow_StockAvailable">
      <bpmn:incoming>Flow_ToStockCheckGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_StockAvailable</bpmn:outgoing>
      <bpmn:outgoing>Flow_OutOfStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_StockAvailable" name="In Stock" sourceRef="Gateway_StockCheck" targetRef="Activity_DeterminePriorityDMN" />

    <bpmn:sequenceFlow id="Flow_OutOfStock" name="Out of Stock" sourceRef="Gateway_StockCheck" targetRef="Activity_NotifyOutOfStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= stockStatus = "OUT_OF_STOCK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Out of Stock Path -->
    <bpmn:serviceTask id="Activity_NotifyOutOfStock" name="Notify Insufficient Stock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notification-service" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OutOfStock</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndOutOfStock</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEndOutOfStock" sourceRef="Activity_NotifyOutOfStock" targetRef="Event_End_OutOfStock" />
    <bpmn:endEvent id="Event_End_OutOfStock" name="Order Cancelled (Out of Stock)">
      <bpmn:incoming>Flow_ToEndOutOfStock</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Business Rule Task: Priority DMN -->
    <bpmn:businessRuleTask id="Activity_DeterminePriorityDMN" name="Determine Order Priority Table">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="decision_order_priority" resultVariable="priorityResult" />
        <zeebe:ioMapping>
          <zeebe:output source="= priorityResult.priority" target="orderPriority" />
          <zeebe:output source="= priorityResult.manualReviewRequired" target="manualReviewRequired" />
          <zeebe:output source="= priorityResult.fulfillmentSlaHours" target="fulfillmentSlaHours" />
          <zeebe:output source="= priorityResult.priorityReason" target="priorityReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StockAvailable</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReviewCheckGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:sequenceFlow id="Flow_ToReviewCheckGateway" sourceRef="Activity_DeterminePriorityDMN" targetRef="Gateway_ManualReviewCheck" />

    <!-- Manual Review Check Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ManualReviewCheck" name="Requires Manual Review?" default="Flow_SkipReview">
      <bpmn:incoming>Flow_ToReviewCheckGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_RequiresReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_SkipReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_RequiresReview" name="Review Needed" sourceRef="Gateway_ManualReviewCheck" targetRef="Activity_ManualOrderVerification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= manualReviewRequired = true or orderTotal &gt; 5000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_SkipReview" name="Auto-Proceed" sourceRef="Gateway_ManualReviewCheck" targetRef="Activity_ProcessPaymentREST" />

    <!-- Tasklist User Task: Manual Order Verification -->
    <bpmn:userTask id="Activity_ManualOrderVerification" name="Manual Order Verification">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="order-managers" />
        <zeebe:ioMapping>
          <zeebe:input source="= orderId" target="orderId" />
          <zeebe:input source="= customerReference" target="customerReference" />
          <zeebe:input source="= orderTotal" target="orderTotal" />
          <zeebe:input source="= orderPriority" target="orderPriority" />
          <zeebe:input source="= priorityReason" target="priorityReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RequiresReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReviewOutcomeGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_ToReviewOutcomeGateway" sourceRef="Activity_ManualOrderVerification" targetRef="Gateway_ReviewOutcome" />

    <!-- Review Outcome Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ReviewOutcome" name="Review Outcome?" default="Flow_ReviewRejected">
      <bpmn:incoming>Flow_ToReviewOutcomeGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewPassed</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReviewRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_ReviewPassed" name="Review Approved" sourceRef="Gateway_ReviewOutcome" targetRef="Activity_ProcessPaymentREST">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ReviewRejected" name="Review Rejected" sourceRef="Gateway_ReviewOutcome" targetRef="Activity_NotifyOrderRejected" />

    <!-- Order Rejected by Review -->
    <bpmn:serviceTask id="Activity_NotifyOrderRejected" name="Notify Order Cancellation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notification-service" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReviewRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndReviewRejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEndReviewRejected" sourceRef="Activity_NotifyOrderRejected" targetRef="Event_End_ReviewRejected" />
    <bpmn:endEvent id="Event_End_ReviewRejected" name="Order Cancelled (Review Rejected)">
      <bpmn:incoming>Flow_ToEndReviewRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- REST Connector: Mock Payment Gateway API -->
    <bpmn:serviceTask id="Activity_ProcessPaymentREST" name="Payment Gateway REST Connector">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" value="paymentApiResponse" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://localhost:8080/api/payment/process" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={orderId: orderId, orderTotal: orderTotal, paymentToken: paymentToken}" target="body" />
          <zeebe:output source="= paymentApiResponse.paymentStatus" target="paymentStatus" />
          <zeebe:output source="= paymentApiResponse.transactionId" target="transactionId" />
          <zeebe:output source="= paymentApiResponse.paymentMessage" target="paymentMessage" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SkipReview</bpmn:incoming>
      <bpmn:incoming>Flow_ReviewPassed</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPaymentOutcomeGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToPaymentOutcomeGateway" sourceRef="Activity_ProcessPaymentREST" targetRef="Gateway_PaymentOutcome" />

    <!-- Payment Outcome Gateway -->
    <bpmn:exclusiveGateway id="Gateway_PaymentOutcome" name="Payment Status?" default="Flow_PaymentSuccess">
      <bpmn:incoming>Flow_ToPaymentOutcomeGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentSuccess</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_PaymentSuccess" name="Payment Succeeded" sourceRef="Gateway_PaymentOutcome" targetRef="Activity_FulfillAndDispatch" />

    <bpmn:sequenceFlow id="Flow_PaymentDeclined" name="Payment Declined" sourceRef="Gateway_PaymentOutcome" targetRef="Activity_NotifyPaymentDeclined">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "DECLINED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Payment Declined Path -->
    <bpmn:serviceTask id="Activity_NotifyPaymentDeclined" name="Notify Payment Declined">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notification-service" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentDeclined</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndPaymentDeclined</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEndPaymentDeclined" sourceRef="Activity_NotifyPaymentDeclined" targetRef="Event_End_PaymentDeclined" />
    <bpmn:endEvent id="Event_End_PaymentDeclined" name="Order Cancelled (Payment Declined)">
      <bpmn:incoming>Flow_ToEndPaymentDeclined</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Fulfillment Path -->
    <bpmn:serviceTask id="Activity_FulfillAndDispatch" name="Fulfill and Dispatch Order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fulfillment-service" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentSuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndOrderFulfilled</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEndOrderFulfilled" sourceRef="Activity_FulfillAndDispatch" targetRef="Event_End_OrderFulfilled" />
    <bpmn:endEvent id="Event_End_OrderFulfilled" name="Order Fulfilled Successfully">
      <bpmn:incoming>Flow_ToEndOrderFulfilled</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_OrderProcessing">
    <bpmndi:BPMNPlane id="BPMNPlane_OrderProcessing" bpmnElement="Process_EcommerceOrderProcessing">
      
      <!-- Shapes -->
      <bpmndi:BPMNShape id="Shape_Event_OrderReceived" bpmnElement="Event_OrderReceived">
        <dc:Bounds x="152" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="131" y="265" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_ValidateAndCheckInventory" bpmnElement="Activity_ValidateAndCheckInventory">
        <dc:Bounds x="240" y="200" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_StockCheck" bpmnElement="Gateway_StockCheck" isMarkerVisible="true">
        <dc:Bounds x="420" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="405" y="185" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_NotifyOutOfStock" bpmnElement="Activity_NotifyOutOfStock">
        <dc:Bounds x="420" y="340" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Event_End_OutOfStock" bpmnElement="Event_End_OutOfStock">
        <dc:Bounds x="600" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="578" y="405" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_DeterminePriorityDMN" bpmnElement="Activity_DeterminePriorityDMN">
        <dc:Bounds x="520" y="200" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_ManualReviewCheck" bpmnElement="Gateway_ManualReviewCheck" isMarkerVisible="true">
        <dc:Bounds x="700" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="683" y="177" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_ManualOrderVerification" bpmnElement="Activity_ManualOrderVerification">
        <dc:Bounds x="800" y="80" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_ReviewOutcome" bpmnElement="Gateway_ReviewOutcome" isMarkerVisible="true">
        <dc:Bounds x="980" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="960" y="65" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_NotifyOrderRejected" bpmnElement="Activity_NotifyOrderRejected">
        <dc:Bounds x="1080" y="80" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Event_End_ReviewRejected" bpmnElement="Event_End_ReviewRejected">
        <dc:Bounds x="1260" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1236" y="145" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_ProcessPaymentREST" bpmnElement="Activity_ProcessPaymentREST">
        <dc:Bounds x="880" y="200" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_PaymentOutcome" bpmnElement="Gateway_PaymentOutcome" isMarkerVisible="true">
        <dc:Bounds x="1060" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1043" y="185" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_FulfillAndDispatch" bpmnElement="Activity_FulfillAndDispatch">
        <dc:Bounds x="1170" y="200" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Event_End_OrderFulfilled" bpmnElement="Event_End_OrderFulfilled">
        <dc:Bounds x="1350" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1334" y="265" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_NotifyPaymentDeclined" bpmnElement="Activity_NotifyPaymentDeclined">
        <dc:Bounds x="1170" y="340" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Event_End_PaymentDeclined" bpmnElement="Event_End_PaymentDeclined">
        <dc:Bounds x="1350" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1328" y="405" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="Edge_Flow_ToValidateOrder" bpmnElement="Flow_ToValidateOrder">
        <di:waypoint x="188" y="240" />
        <di:waypoint x="240" y="240" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToStockCheckGateway" bpmnElement="Flow_ToStockCheckGateway">
        <di:waypoint x="370" y="240" />
        <di:waypoint x="420" y="240" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_StockAvailable" bpmnElement="Flow_StockAvailable">
        <di:waypoint x="470" y="240" />
        <di:waypoint x="520" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="475" y="222" width="41" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_OutOfStock" bpmnElement="Flow_OutOfStock">
        <di:waypoint x="445" y="265" />
        <di:waypoint x="445" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="450" y="285" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToEndOutOfStock" bpmnElement="Flow_ToEndOutOfStock">
        <di:waypoint x="550" y="380" />
        <di:waypoint x="600" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToReviewCheckGateway" bpmnElement="Flow_ToReviewCheckGateway">
        <di:waypoint x="650" y="240" />
        <di:waypoint x="700" y="240" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_RequiresReview" bpmnElement="Flow_RequiresReview">
        <di:waypoint x="725" y="215" />
        <di:waypoint x="725" y="120" />
        <di:waypoint x="800" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="730" y="143" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_SkipReview" bpmnElement="Flow_SkipReview">
        <di:waypoint x="750" y="240" />
        <di:waypoint x="880" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="782" y="222" width="67" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToReviewOutcomeGateway" bpmnElement="Flow_ToReviewOutcomeGateway">
        <di:waypoint x="930" y="120" />
        <di:waypoint x="980" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ReviewPassed" bpmnElement="Flow_ReviewPassed">
        <di:waypoint x="1005" y="145" />
        <di:waypoint x="1005" y="170" />
        <di:waypoint x="945" y="170" />
        <di:waypoint x="945" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="950" y="178" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ReviewRejected" bpmnElement="Flow_ReviewRejected">
        <di:waypoint x="1030" y="120" />
        <di:waypoint x="1080" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1032" y="102" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToEndReviewRejected" bpmnElement="Flow_ToEndReviewRejected">
        <di:waypoint x="1210" y="120" />
        <di:waypoint x="1260" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToPaymentOutcomeGateway" bpmnElement="Flow_ToPaymentOutcomeGateway">
        <di:waypoint x="1010" y="240" />
        <di:waypoint x="1060" y="240" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_PaymentSuccess" bpmnElement="Flow_PaymentSuccess">
        <di:waypoint x="1110" y="240" />
        <di:waypoint x="1170" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1111" y="222" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_PaymentDeclined" bpmnElement="Flow_PaymentDeclined">
        <di:waypoint x="1085" y="265" />
        <di:waypoint x="1085" y="380" />
        <di:waypoint x="1170" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1090" y="313" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToEndOrderFulfilled" bpmnElement="Flow_ToEndOrderFulfilled">
        <di:waypoint x="1300" y="240" />
        <di:waypoint x="1350" y="240" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToEndPaymentDeclined" bpmnElement="Flow_ToEndPaymentDeclined">
        <di:waypoint x="1300" y="380" />
        <di:waypoint x="1350" y="380" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
