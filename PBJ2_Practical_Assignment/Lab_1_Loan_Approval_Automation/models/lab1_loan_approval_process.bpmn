<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_LoanApproval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.5.0">
  <bpmn:process id="Process_LoanApprovalAutomation" name="Lab 1: End-to-End Loan Approval Automation" isExecutable="true">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Event_LoanAppReceived" name="Loan Application Submitted">
      <bpmn:outgoing>Flow_ToValidateApplicant</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Java Spring Boot External Job Worker -->
    <bpmn:serviceTask id="Activity_ValidateApplicant" name="Validate Applicant Information">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-loan-applicant" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="= applicantId" target="applicantId" />
          <zeebe:input source="= applicantName" target="applicantName" />
          <zeebe:input source="= requestedAmount" target="requestedAmount" />
          <zeebe:input source="= monthlyIncome" target="monthlyIncome" />
          <zeebe:input source="= existingMonthlyDebt" target="existingMonthlyDebt" />
          <zeebe:output source="= applicantValid" target="applicantValid" />
          <zeebe:output source="= debtToIncomeRatio" target="debtToIncomeRatio" />
          <zeebe:output source="= validationNotes" target="validationNotes" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidateApplicant</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidationCheck</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToValidateApplicant" sourceRef="Event_LoanAppReceived" targetRef="Activity_ValidateApplicant" />
    <bpmn:sequenceFlow id="Flow_ToValidationCheck" sourceRef="Activity_ValidateApplicant" targetRef="Gateway_ValidationCheck" />

    <!-- Validation Check Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ValidationCheck" name="Applicant Data Valid?" default="Flow_ValidationPassed">
      <bpmn:incoming>Flow_ToValidationCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidationPassed</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidationFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_ValidationPassed" name="Valid Data" sourceRef="Gateway_ValidationCheck" targetRef="Activity_CreditAssessmentREST" />
    
    <bpmn:sequenceFlow id="Flow_ValidationFailed" name="Invalid Data" sourceRef="Gateway_ValidationCheck" targetRef="Activity_NotifyValidationFailed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= applicantValid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Activity_NotifyValidationFailed" name="Notify Validation Failure">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notification-service" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidationFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndValidationFailed</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEndValidationFailed" sourceRef="Activity_NotifyValidationFailed" targetRef="Event_End_ValidationFailed" />
    <bpmn:endEvent id="Event_End_ValidationFailed" name="Application Terminated (Invalid Data)">
      <bpmn:incoming>Flow_ToEndValidationFailed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- REST Connector: Simulated Credit Assessment API -->
    <bpmn:serviceTask id="Activity_CreditAssessmentREST" name="Credit Assessment REST Connector">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" value="creditApiResponse" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://localhost:8080/api/credit/assess" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={applicantId: applicantId, requestedAmount: requestedAmount, monthlyIncome: monthlyIncome}" target="body" />
          <zeebe:output source="= creditApiResponse.creditScore" target="creditScore" />
          <zeebe:output source="= creditApiResponse.riskScore" target="riskScore" />
          <zeebe:output source="= creditApiResponse.creditAssessmentRemarks" target="creditAssessmentRemarks" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidationPassed</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEvaluateLoanDMN</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEvaluateLoanDMN" sourceRef="Activity_CreditAssessmentREST" targetRef="Activity_EvaluateLoanDMN" />

    <!-- Business Rule Task: DMN Decision Table -->
    <bpmn:businessRuleTask id="Activity_EvaluateLoanDMN" name="Evaluate Loan Decision Table">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="decision_loan_approval" resultVariable="loanDecisionResult" />
        <zeebe:ioMapping>
          <zeebe:output source="= loanDecisionResult.decision" target="decision" />
          <zeebe:output source="= loanDecisionResult.interestRate" target="interestRate" />
          <zeebe:output source="= loanDecisionResult.decisionReason" target="decisionReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEvaluateLoanDMN</bpmn:incoming>
      <bpmn:outgoing>Flow_ToLoanDecisionGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:sequenceFlow id="Flow_ToLoanDecisionGateway" sourceRef="Activity_EvaluateLoanDMN" targetRef="Gateway_LoanDecision" />

    <!-- Decision Routing Exclusive Gateway -->
    <bpmn:exclusiveGateway id="Gateway_LoanDecision" name="Evaluate Loan Outcome" default="Flow_ManualReview">
      <bpmn:incoming>Flow_ToLoanDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManualReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Approved" name="decision == &#34;Approved&#34;" sourceRef="Gateway_LoanDecision" targetRef="Activity_DisburseLoan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = "Approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Rejected" name="decision == &#34;Rejected&#34;" sourceRef="Gateway_LoanDecision" targetRef="Activity_NotifyRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= decision = "Rejected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ManualReview" name="decision == &#34;Manual Review&#34;" sourceRef="Gateway_LoanDecision" targetRef="Activity_ManualLoanReview" />

    <!-- User Task: Tasklist Manual Review -->
    <bpmn:userTask id="Activity_ManualLoanReview" name="Manual Loan Review by Underwriter">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="loan-underwriters" />
        <zeebe:ioMapping>
          <zeebe:input source="= applicantId" target="applicantId" />
          <zeebe:input source="= applicantName" target="applicantName" />
          <zeebe:input source="= requestedAmount" target="requestedAmount" />
          <zeebe:input source="= monthlyIncome" target="monthlyIncome" />
          <zeebe:input source="= creditScore" target="creditScore" />
          <zeebe:input source="= debtToIncomeRatio" target="debtToIncomeRatio" />
          <zeebe:input source="= decisionReason" target="decisionReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ManualReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToManualReviewOutcome</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_ToManualReviewOutcome" sourceRef="Activity_ManualLoanReview" targetRef="Gateway_ManualReviewOutcome" />

    <!-- Gateway after Manual Review -->
    <bpmn:exclusiveGateway id="Gateway_ManualReviewOutcome" name="Underwriter Approval?" default="Flow_ReviewRejected">
      <bpmn:incoming>Flow_ToManualReviewOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReviewRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_ReviewApproved" name="Underwriter Approved" sourceRef="Gateway_ManualReviewOutcome" targetRef="Activity_DisburseLoan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "Approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ReviewRejected" name="Underwriter Rejected" sourceRef="Gateway_ManualReviewOutcome" targetRef="Activity_NotifyRejected" />

    <!-- Approved Path: Disburse Loan -->
    <bpmn:serviceTask id="Activity_DisburseLoan" name="Disburse Loan Funds">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="loan-disbursement-service" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:incoming>Flow_ReviewApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndApproved</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEndApproved" sourceRef="Activity_DisburseLoan" targetRef="Event_End_Approved" />
    <bpmn:endEvent id="Event_End_Approved" name="Loan Approved and Disbursed">
      <bpmn:incoming>Flow_ToEndApproved</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Rejected Path: Send Notification -->
    <bpmn:serviceTask id="Activity_NotifyRejected" name="Send Loan Rejection Notice">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notification-service" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:incoming>Flow_ReviewRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndRejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_ToEndRejected" sourceRef="Activity_NotifyRejected" targetRef="Event_End_Rejected" />
    <bpmn:endEvent id="Event_End_Rejected" name="Loan Rejected">
      <bpmn:incoming>Flow_ToEndRejected</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_LoanApproval">
    <bpmndi:BPMNPlane id="BPMNPlane_LoanApproval" bpmnElement="Process_LoanApprovalAutomation">
      
      <!-- Shapes -->
      <bpmndi:BPMNShape id="Shape_Event_LoanAppReceived" bpmnElement="Event_LoanAppReceived">
        <dc:Bounds x="160" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="135" y="265" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_ValidateApplicant" bpmnElement="Activity_ValidateApplicant">
        <dc:Bounds x="250" y="200" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_ValidationCheck" bpmnElement="Gateway_ValidationCheck" isMarkerVisible="true">
        <dc:Bounds x="430" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="419" y="185" width="73" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_NotifyValidationFailed" bpmnElement="Activity_NotifyValidationFailed">
        <dc:Bounds x="430" y="340" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Event_End_ValidationFailed" bpmnElement="Event_End_ValidationFailed">
        <dc:Bounds x="610" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="599" y="405" width="60" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_CreditAssessmentREST" bpmnElement="Activity_CreditAssessmentREST">
        <dc:Bounds x="530" y="200" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_EvaluateLoanDMN" bpmnElement="Activity_EvaluateLoanDMN">
        <dc:Bounds x="710" y="200" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_LoanDecision" bpmnElement="Gateway_LoanDecision" isMarkerVisible="true">
        <dc:Bounds x="890" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="878" y="185" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_DisburseLoan" bpmnElement="Activity_DisburseLoan">
        <dc:Bounds x="1010" y="80" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Event_End_Approved" bpmnElement="Event_End_Approved">
        <dc:Bounds x="1190" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1173" y="145" width="72" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_ManualLoanReview" bpmnElement="Activity_ManualLoanReview">
        <dc:Bounds x="1010" y="200" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_ManualReviewOutcome" bpmnElement="Gateway_ManualReviewOutcome" isMarkerVisible="true">
        <dc:Bounds x="1190" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1186" y="272" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Activity_NotifyRejected" bpmnElement="Activity_NotifyRejected">
        <dc:Bounds x="1010" y="340" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Event_End_Rejected" bpmnElement="Event_End_Rejected">
        <dc:Bounds x="1190" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1175" y="405" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="Edge_Flow_ToValidateApplicant" bpmnElement="Flow_ToValidateApplicant">
        <di:waypoint x="196" y="240" />
        <di:waypoint x="250" y="240" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToValidationCheck" bpmnElement="Flow_ToValidationCheck">
        <di:waypoint x="380" y="240" />
        <di:waypoint x="430" y="240" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ValidationPassed" bpmnElement="Flow_ValidationPassed">
        <di:waypoint x="480" y="240" />
        <di:waypoint x="530" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="482" y="222" width="46" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ValidationFailed" bpmnElement="Flow_ValidationFailed">
        <di:waypoint x="455" y="265" />
        <di:waypoint x="455" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="460" y="283" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToEndValidationFailed" bpmnElement="Flow_ToEndValidationFailed">
        <di:waypoint x="560" y="380" />
        <di:waypoint x="610" y="380" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToEvaluateLoanDMN" bpmnElement="Flow_ToEvaluateLoanDMN">
        <di:waypoint x="660" y="240" />
        <di:waypoint x="710" y="240" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToLoanDecisionGateway" bpmnElement="Flow_ToLoanDecisionGateway">
        <di:waypoint x="840" y="240" />
        <di:waypoint x="890" y="240" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_Approved" bpmnElement="Flow_Approved">
        <di:waypoint x="915" y="215" />
        <di:waypoint x="915" y="120" />
        <di:waypoint x="1010" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="923" y="143" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ManualReview" bpmnElement="Flow_ManualReview">
        <di:waypoint x="940" y="240" />
        <di:waypoint x="1010" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="941" y="222" width="67" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_Rejected" bpmnElement="Flow_Rejected">
        <di:waypoint x="915" y="265" />
        <di:waypoint x="915" y="380" />
        <di:waypoint x="1010" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="923" y="333" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToEndApproved" bpmnElement="Flow_ToEndApproved">
        <di:waypoint x="1140" y="120" />
        <di:waypoint x="1190" y="120" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToManualReviewOutcome" bpmnElement="Flow_ToManualReviewOutcome">
        <di:waypoint x="1140" y="240" />
        <di:waypoint x="1190" y="240" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ReviewApproved" bpmnElement="Flow_ReviewApproved">
        <di:waypoint x="1215" y="215" />
        <di:waypoint x="1215" y="160" />
        <di:waypoint x="1140" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1219" y="176" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ReviewRejected" bpmnElement="Flow_ReviewRejected">
        <di:waypoint x="1215" y="265" />
        <di:waypoint x="1215" y="360" />
        <di:waypoint x="1140" y="360" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1219" y="296" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_ToEndRejected" bpmnElement="Flow_ToEndRejected">
        <di:waypoint x="1140" y="380" />
        <di:waypoint x="1190" y="380" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
