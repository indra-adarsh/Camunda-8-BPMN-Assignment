      <ns4:BPMNShape id="Activity_ReviewCounterOffer_di" bpmnElement="Activity_ReviewCounterOffer">
        <ns5:Bounds x="1420" y="250" width="120" height="80" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Gateway_CounterOfferAcceptance_di" bpmnElement="Gateway_CounterOfferAcceptance" isMarkerVisible="true">
        <ns5:Bounds x="1575" y="265" width="50" height="50" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="1568" y="322" width="65" height="27" />
        </ns4:BPMNLabel>
