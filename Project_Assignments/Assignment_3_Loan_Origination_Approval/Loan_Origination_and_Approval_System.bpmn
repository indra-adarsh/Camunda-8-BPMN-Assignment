      <ns4:BPMNShape id="Activity_AcceptOffer_di" bpmnElement="Activity_AcceptOffer">
        <ns5:Bounds x="1890" y="250" width="120" height="80" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Event_Timer_OfferExpiry_di" bpmnElement="Event_Timer_OfferExpiry">
        <ns5:Bounds x="1972" y="312" width="36" height="36" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="1998" y="328" width="84" height="27" />
