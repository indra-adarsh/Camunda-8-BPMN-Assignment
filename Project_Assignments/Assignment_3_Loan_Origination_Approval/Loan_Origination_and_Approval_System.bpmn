<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://camunda.org/schema/modeler/1.0" xmlns:ns2="http://camunda.org/schema/zeebe/1.0" xmlns:ns4="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns5="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns6="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LoanOrigination" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.9.0">
  <ns0:collaboration id="Collaboration_LoanOrigination">
    <ns0:participant id="Participant_CreditBureau" name="Credit Bureau (External Agency)" />
    <ns0:participant id="Participant_Bank" name="Bank Loan Origination &amp; Approval System" processRef="Process_LoanOrigination" />
    <ns0:messageFlow id="MsgFlow_RequestScore" name="Credit Score Request" sourceRef="Activity_RequestBureauScore" targetRef="Participant_CreditBureau" />
    <ns0:messageFlow id="MsgFlow_ReceiveScore" name="Credit Score Report" sourceRef="Participant_CreditBureau" targetRef="Activity_RequestBureauScore" />
  </ns0:collaboration>

  <ns0:process id="Process_LoanOrigination" name="Loan Origination &amp; Approval System" isExecutable="true">
    <ns0:laneSet id="LaneSet_Bank">
      <ns0:lane id="Lane_Applicant" name="Applicant">
        <ns0:flowNodeRef>Event_Start_Application</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_UploadMissingDocs</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_Timer_DocMissing</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_Lapsed</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_ReviewCounterOffer</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_CounterOfferAcceptance</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_CounterDeclined</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_AcceptOffer</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_Timer_OfferExpiry</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_OfferExpired</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_ESignAgreement</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_ESignAttempts</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_ESignCancelled</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_Withdrawn</ns0:flowNodeRef>
      </ns0:lane>

      <ns0:lane id="Lane_LoanOfficer" name="Loan Officer">
        <ns0:flowNodeRef>Activity_ManualKYCResolution</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_ManualKYCDecision</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_KYCRejected</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_ManualCreditCheck</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_VerifyIncome</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_PrepareCounterOffer</ns0:flowNodeRef>
      </ns0:lane>

      <ns0:lane id="Lane_Underwriter" name="Underwriter / Credit Committee">
        <ns0:flowNodeRef>Activity_UnderwriterReview</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_AdditionalChecks</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_SeniorCommitteeApproval</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_JoinUnderwriting</ns0:flowNodeRef>
      </ns0:lane>

      <ns0:lane id="Lane_Compliance" name="Fraud &amp; Compliance Team">
        <ns0:flowNodeRef>SubProcess_FraudInvestigation</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_TerminatedFraud</ns0:flowNodeRef>
      </ns0:lane>

      <ns0:lane id="Lane_Operations" name="Operations / Disbursement">
        <ns0:flowNodeRef>Activity_CollateralValuation</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_CollateralOutcome</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_TitleRejected</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_DisburseFunds</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_Error_DisbursementFail</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_ResolveDisbursementIssue</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_Throw_CompensateAccount</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_DisbursementFailed</ns0:flowNodeRef>
      </ns0:lane>

      <ns0:lane id="Lane_CoreBanking" name="Core Banking System">
        <ns0:flowNodeRef>Activity_CheckDocCompleteness</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_DocCompleteness</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_RequestMissingDocs</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_ForkVerification</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_VerifyKYC</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_KYCResult</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_RequestBureauScore</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_Error_BureauAPI</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_BureauRetries</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_JoinVerification</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_FraudScreening</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_FraudOutcome</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_AssessEligibility</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_EligibilityOutcome</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_ScoreRejected</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_GenerateLoanOffer</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_SendOffer</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_CreateLoanAccount</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_Comp_Account</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_ReverseLoanAccount</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_NotifyDisbursement</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_LoanDisbursed</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>

    
    <ns0:boundaryEvent id="Event_Message_Withdrawal" name="Applicant Cancellation / Withdrawal (L10)" attachedToRef="Activity_UnderwriterReview">
      <ns0:outgoing>Flow_Withdrawal_To_Comp</ns0:outgoing>
      <ns0:messageEventDefinition id="MessageEventDef_Withdraw" messageRef="Message_WithdrawLoan" />
    </ns0:boundaryEvent>
    <ns0:intermediateThrowEvent id="Event_Throw_WithdrawCompensation" name="Reverse Processing Fees &amp; Holds (L10)">
      <ns0:incoming>Flow_Withdrawal_To_Comp</ns0:incoming>
      <ns0:outgoing>Flow_To_WithdrawnEnd</ns0:outgoing>
      <ns0:compensateEventDefinition id="CompEventDef_Withdraw" />
    </ns0:intermediateThrowEvent>
    <ns0:endEvent id="Event_End_Withdrawn" name="End (Loan Withdrawn)">
      <ns0:incoming>Flow_To_WithdrawnEnd</ns0:incoming>
    </ns0:endEvent>

    
    <ns0:startEvent id="Event_Start_Application" name="Loan Application &amp; Documents Submitted">
      <ns0:outgoing>Flow_Start_To_DocCheck</ns0:outgoing>
      <ns0:messageEventDefinition id="MessageEventDef_Start" messageRef="Message_ApplicationSubmitted" />
    </ns0:startEvent>
    <ns0:userTask id="Activity_UploadMissingDocs" name="Upload Missing Documents (L1)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_To_UploadMissing</ns0:incoming>
      <ns0:outgoing>Flow_ResubmitDocs_To_Check</ns0:outgoing>
    </ns0:userTask>
    <ns0:boundaryEvent id="Event_Timer_DocMissing" name="7-Day SLA Expired (L1)" attachedToRef="Activity_UploadMissingDocs">
      <ns0:outgoing>Flow_DocTimer_To_Lapse</ns0:outgoing>
      <ns0:timerEventDefinition id="TimerEventDef_MissingDoc">
        <ns0:timeDuration xsi:type="bpmn:tFormalExpression">P7D</ns0:timeDuration>
      </ns0:timerEventDefinition>
    </ns0:boundaryEvent>
    <ns0:endEvent id="Event_End_Lapsed" name="End (Application Lapsed)">
      <ns0:incoming>Flow_DocTimer_To_Lapse</ns0:incoming>
    </ns0:endEvent>
    <ns0:userTask id="Activity_ReviewCounterOffer" name="Review Counter-Offer / Guarantor Terms (L5, L6)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_To_ReviewCounterOffer</ns0:incoming>
      <ns0:outgoing>Flow_To_CounterDecision</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gateway_CounterOfferAcceptance" name="Counter-Offer Accepted?">
      <ns0:incoming>Flow_To_CounterDecision</ns0:incoming>
      <ns0:outgoing>Flow_Counter_Accepted</ns0:outgoing>
      <ns0:outgoing>Flow_Counter_Declined</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="Event_End_CounterDeclined" name="End (Counter-Offer Declined)">
      <ns0:incoming>Flow_Counter_Declined</ns0:incoming>
    </ns0:endEvent>
    <ns0:userTask id="Activity_AcceptOffer" name="Review &amp; Accept Loan Offer">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_SendOffer_To_Accept</ns0:incoming>
      <ns0:outgoing>Flow_Accept_To_ESign</ns0:outgoing>
    </ns0:userTask>
    <ns0:boundaryEvent id="Event_Timer_OfferExpiry" name="15-Day Offer Validity Expired (L9)" attachedToRef="Activity_AcceptOffer">
      <ns0:outgoing>Flow_OfferExpired_To_End</ns0:outgoing>
      <ns0:timerEventDefinition id="TimerEventDef_OfferExpiry">
        <ns0:timeDuration xsi:type="bpmn:tFormalExpression">P15D</ns0:timeDuration>
      </ns0:timerEventDefinition>
    </ns0:boundaryEvent>
    <ns0:endEvent id="Event_End_OfferExpired" name="End (Offer Expired)">
      <ns0:incoming>Flow_OfferExpired_To_End</ns0:incoming>
    </ns0:endEvent>
    <ns0:userTask id="Activity_ESignAgreement" name="E-Sign Loan Agreement (L11)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Accept_To_ESign</ns0:incoming>
      <ns0:incoming>Flow_ESign_Retry</ns0:incoming>
      <ns0:outgoing>Flow_ESign_To_AttemptCheck</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gateway_ESignAttempts" name="Signature Valid &amp; Signed? (L11)">
      <ns0:incoming>Flow_ESign_To_AttemptCheck</ns0:incoming>
      <ns0:outgoing>Flow_ESign_Success</ns0:outgoing>
      <ns0:outgoing>Flow_ESign_Retry</ns0:outgoing>
      <ns0:outgoing>Flow_ESign_Failed</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="Event_End_ESignCancelled" name="End (Offer Cancelled - Signature Failed)">
      <ns0:incoming>Flow_ESign_Failed</ns0:incoming>
    </ns0:endEvent>

    
    <ns0:userTask id="Activity_ManualKYCResolution" name="Manual KYC Investigation &amp; Resolution (L2)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_KYC_Mismatch</ns0:incoming>
      <ns0:outgoing>Flow_To_ManualKYCDecision</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gateway_ManualKYCDecision" name="KYC Resolved?">
      <ns0:incoming>Flow_To_ManualKYCDecision</ns0:incoming>
      <ns0:outgoing>Flow_KYC_Resolved</ns0:outgoing>
      <ns0:outgoing>Flow_KYC_Unresolved</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="Event_End_KYCRejected" name="End (Rejected - KYC Mismatch)">
      <ns0:incoming>Flow_KYC_Unresolved</ns0:incoming>
    </ns0:endEvent>
    <ns0:userTask id="Activity_ManualCreditCheck" name="Fallback Manual Credit Bureau Check (L4)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Bureau_MaxRetries</ns0:incoming>
      <ns0:outgoing>Flow_ManualBureau_To_Join</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Activity_VerifyIncome" name="Income &amp; Employment Verification">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Fork_To_Income</ns0:incoming>
      <ns0:outgoing>Flow_Income_To_Join</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Activity_PrepareCounterOffer" name="Prepare Counter-Offer / Guarantor Request (L5, L6)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Eligibility_Counter</ns0:incoming>
      <ns0:outgoing>Flow_To_ReviewCounterOffer</ns0:outgoing>
    </ns0:userTask>

    
    <ns0:userTask id="Activity_UnderwriterReview" name="Underwriter Review &amp; Assessment">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Eligibility_Manual</ns0:incoming>
      <ns0:outgoing>Flow_Underwriter_To_Checks</ns0:outgoing>
    </ns0:userTask>
    <ns0:inclusiveGateway id="Gateway_AdditionalChecks" name="Determine Policy Checks Needed (L7, L8)">
      <ns0:incoming>Flow_Underwriter_To_Checks</ns0:incoming>
      <ns0:outgoing>Flow_Checks_To_SeniorCommittee</ns0:outgoing>
      <ns0:outgoing>Flow_Checks_To_Collateral</ns0:outgoing>
      <ns0:outgoing>Flow_Checks_Standard</ns0:outgoing>
    </ns0:inclusiveGateway>
    <ns0:userTask id="Activity_SeniorCommitteeApproval" name="Senior Credit Committee Approval (L7)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Checks_To_SeniorCommittee</ns0:incoming>
      <ns0:outgoing>Flow_Senior_To_Join</ns0:outgoing>
    </ns0:userTask>
    <ns0:inclusiveGateway id="Gateway_JoinUnderwriting" name="Consolidate Underwriting Outcomes">
      <ns0:incoming>Flow_Senior_To_Join</ns0:incoming>
      <ns0:incoming>Flow_Collateral_Approved</ns0:incoming>
      <ns0:incoming>Flow_Checks_Standard</ns0:incoming>
      <ns0:outgoing>Flow_Underwriting_To_Offer</ns0:outgoing>
    </ns0:inclusiveGateway>

    
    <ns0:subProcess id="SubProcess_FraudInvestigation" name="Fraud &amp; AML Compliance Investigation (L3)">
      <ns0:incoming>Flow_Fraud_Hit</ns0:incoming>
      <ns0:outgoing>Flow_Fraud_To_End</ns0:outgoing>
      <ns0:startEvent id="SubEvent_FraudStart" name="Trigger Investigation">
        <ns0:outgoing>SubFlow_F1</ns0:outgoing>
      </ns0:startEvent>
      <ns0:userTask id="Activity_AnalyzeFraudIndicators" name="Analyze Forged Docs &amp; Sanctions Hit">
        <ns0:extensionElements>
          <ns2:userTask />
        </ns0:extensionElements>
        <ns0:incoming>SubFlow_F1</ns0:incoming>
        <ns0:outgoing>SubFlow_F2</ns0:outgoing>
      </ns0:userTask>
      <ns0:serviceTask id="Activity_FileSARReport" name="File Regulatory SAR / AML Report">
        <ns0:extensionElements>
          <ns2:taskDefinition type="file-sar-report" />
        </ns0:extensionElements>
        <ns0:incoming>SubFlow_F2</ns0:incoming>
        <ns0:outgoing>SubFlow_F3</ns0:outgoing>
      </ns0:serviceTask>
      <ns0:endEvent id="SubEvent_FraudEnd" name="Investigation Logged">
        <ns0:incoming>SubFlow_F3</ns0:incoming>
      </ns0:endEvent>
      <ns0:sequenceFlow id="SubFlow_F1" sourceRef="SubEvent_FraudStart" targetRef="Activity_AnalyzeFraudIndicators" />
      <ns0:sequenceFlow id="SubFlow_F2" sourceRef="Activity_AnalyzeFraudIndicators" targetRef="Activity_FileSARReport" />
      <ns0:sequenceFlow id="SubFlow_F3" sourceRef="Activity_FileSARReport" targetRef="SubEvent_FraudEnd" />
    </ns0:subProcess>
    <ns0:endEvent id="Event_End_TerminatedFraud" name="Terminate (Fraud / AML Confirmed)">
      <ns0:incoming>Flow_Fraud_To_End</ns0:incoming>
      <ns0:terminateEventDefinition id="TerminateEventDef_Fraud" />
    </ns0:endEvent>

    
    <ns0:userTask id="Activity_CollateralValuation" name="Collateral Valuation &amp; Title Verification (L8)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Checks_To_Collateral</ns0:incoming>
      <ns0:outgoing>Flow_To_CollateralOutcome</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gateway_CollateralOutcome" name="Title &amp; Valuation Valid? (L8)">
      <ns0:incoming>Flow_To_CollateralOutcome</ns0:incoming>
      <ns0:outgoing>Flow_Collateral_Approved</ns0:outgoing>
      <ns0:outgoing>Flow_Collateral_TitleIssue</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="Event_End_TitleRejected" name="End (Rejected - Title Issues)">
      <ns0:incoming>Flow_Collateral_TitleIssue</ns0:incoming>
    </ns0:endEvent>

    <ns0:serviceTask id="Activity_DisburseFunds" name="Verify Account &amp; Transfer Funds (L12)">
      <ns0:extensionElements>
        <ns2:taskDefinition type="disburse-funds-transfer" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_AccountCreated_To_Disburse</ns0:incoming>
      <ns0:incoming>Flow_Disbursement_Retry</ns0:incoming>
      <ns0:outgoing>Flow_Disburse_To_Notify</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:boundaryEvent id="Event_Error_DisbursementFail" name="Payment Gateway / Account Error (L12)" attachedToRef="Activity_DisburseFunds">
      <ns0:outgoing>Flow_To_ResolveDisbursement</ns0:outgoing>
      <ns0:errorEventDefinition id="ErrorEventDef_Disburse" errorRef="Error_PaymentGateway" />
    </ns0:boundaryEvent>
    <ns0:userTask id="Activity_ResolveDisbursementIssue" name="Resolve Account Discrepancy &amp; Hold Funds (L12)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_To_ResolveDisbursement</ns0:incoming>
      <ns0:outgoing>Flow_To_DisburseRetryDecision</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gateway_DisburseRetryDecision" name="Account Verified?">
      <ns0:incoming>Flow_To_DisburseRetryDecision</ns0:incoming>
      <ns0:outgoing>Flow_Disbursement_Retry</ns0:outgoing>
      <ns0:outgoing>Flow_Disbursement_FailFinal</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:intermediateThrowEvent id="Event_Throw_CompensateAccount" name="Reverse Loan Account Creation (L12)">
      <ns0:incoming>Flow_Disbursement_FailFinal</ns0:incoming>
      <ns0:outgoing>Flow_To_DisbursementFailEnd</ns0:outgoing>
      <ns0:compensateEventDefinition id="CompEventDef_Account" />
    </ns0:intermediateThrowEvent>
    <ns0:endEvent id="Event_End_DisbursementFailed" name="End (Disbursement Failed)">
      <ns0:incoming>Flow_To_DisbursementFailEnd</ns0:incoming>
    </ns0:endEvent>

    
    <ns0:businessRuleTask id="Activity_CheckDocCompleteness" name="Check Document Completeness (L1)">
      <ns0:extensionElements>
        <ns2:calledDecision decisionId="check-doc-completeness" resultVariable="docCompletenessResult" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Start_To_DocCheck</ns0:incoming>
      <ns0:incoming>Flow_ResubmitDocs_To_Check</ns0:incoming>
      <ns0:outgoing>Flow_To_DocCompleteness</ns0:outgoing>
    </ns0:businessRuleTask>
    <ns0:exclusiveGateway id="Gateway_DocCompleteness" name="Documents Complete?">
      <ns0:incoming>Flow_To_DocCompleteness</ns0:incoming>
      <ns0:outgoing>Flow_Docs_Complete</ns0:outgoing>
      <ns0:outgoing>Flow_Docs_Incomplete</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Activity_RequestMissingDocs" name="Generate Missing Items List &amp; Set 7-Day Timer (L1)">
      <ns0:extensionElements>
        <ns2:taskDefinition type="request-missing-docs" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Docs_Incomplete</ns0:incoming>
      <ns0:outgoing>Flow_To_UploadMissing</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:parallelGateway id="Gateway_ForkVerification" name="Initiate Concurrent Verifications">
      <ns0:incoming>Flow_Docs_Complete</ns0:incoming>
      <ns0:outgoing>Flow_Fork_To_KYC</ns0:outgoing>
      <ns0:outgoing>Flow_Fork_To_Bureau</ns0:outgoing>
      <ns0:outgoing>Flow_Fork_To_Income</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:serviceTask id="Activity_VerifyKYC" name="Automated KYC Identity Verification (L2)">
      <ns0:extensionElements>
        <ns2:taskDefinition type="automated-kyc-check" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Fork_To_KYC</ns0:incoming>
      <ns0:outgoing>Flow_To_KYCResult</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gateway_KYCResult" name="KYC Identity Matched?">
      <ns0:incoming>Flow_To_KYCResult</ns0:incoming>
      <ns0:outgoing>Flow_KYC_Matched</ns0:outgoing>
      <ns0:outgoing>Flow_KYC_Mismatch</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Activity_RequestBureauScore" name="Retrieve Credit Bureau Score (L4)">
      <ns0:extensionElements>
        <ns2:taskDefinition type="retrieve-bureau-score" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Fork_To_Bureau</ns0:incoming>
      <ns0:incoming>Flow_Bureau_Retry</ns0:incoming>
      <ns0:outgoing>Flow_Bureau_Success</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:boundaryEvent id="Event_Error_BureauAPI" name="Bureau API Timeout / Error (L4)" attachedToRef="Activity_RequestBureauScore">
      <ns0:outgoing>Flow_To_BureauRetries</ns0:outgoing>
      <ns0:errorEventDefinition id="ErrorEventDef_Bureau" errorRef="Error_BureauDown" />
    </ns0:boundaryEvent>
    <ns0:exclusiveGateway id="Gateway_BureauRetries" name="API Retries &lt; 3?">
      <ns0:incoming>Flow_To_BureauRetries</ns0:incoming>
      <ns0:outgoing>Flow_Bureau_Retry</ns0:outgoing>
      <ns0:outgoing>Flow_Bureau_MaxRetries</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:parallelGateway id="Gateway_JoinVerification" name="Synchronize All Verifications">
      <ns0:incoming>Flow_KYC_Matched</ns0:incoming>
      <ns0:incoming>Flow_KYC_Resolved</ns0:incoming>
      <ns0:incoming>Flow_Bureau_Success</ns0:incoming>
      <ns0:incoming>Flow_ManualBureau_To_Join</ns0:incoming>
      <ns0:incoming>Flow_Income_To_Join</ns0:incoming>
      <ns0:outgoing>Flow_Join_To_Fraud</ns0:outgoing>
    </ns0:parallelGateway>
    <ns0:businessRuleTask id="Activity_FraudScreening" name="Automated Fraud &amp; AML Screening (L3)">
      <ns0:extensionElements>
        <ns2:calledDecision decisionId="screen-fraud-aml" resultVariable="fraudScreeningResult" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Join_To_Fraud</ns0:incoming>
      <ns0:outgoing>Flow_To_FraudOutcome</ns0:outgoing>
    </ns0:businessRuleTask>
    <ns0:exclusiveGateway id="Gateway_FraudOutcome" name="Fraud / Sanctions Hit?">
      <ns0:incoming>Flow_To_FraudOutcome</ns0:incoming>
      <ns0:outgoing>Flow_Fraud_Clean</ns0:outgoing>
      <ns0:outgoing>Flow_Fraud_Hit</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:businessRuleTask id="Activity_AssessEligibility" name="Eligibility &amp; Risk Scoring Engine (L5, L6)">
      <ns0:extensionElements>
        <ns2:calledDecision decisionId="assess-loan-eligibility" resultVariable="eligibilityResult" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Fraud_Clean</ns0:incoming>
      <ns0:incoming>Flow_Counter_Accepted</ns0:incoming>
      <ns0:outgoing>Flow_To_EligibilityOutcome</ns0:outgoing>
    </ns0:businessRuleTask>
    <ns0:exclusiveGateway id="Gateway_EligibilityOutcome" name="Scoring Outcome?">
      <ns0:incoming>Flow_To_EligibilityOutcome</ns0:incoming>
      <ns0:outgoing>Flow_Eligibility_AutoApprove</ns0:outgoing>
      <ns0:outgoing>Flow_Eligibility_Manual</ns0:outgoing>
      <ns0:outgoing>Flow_Eligibility_Counter</ns0:outgoing>
      <ns0:outgoing>Flow_Eligibility_Reject</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="Event_End_ScoreRejected" name="End (Rejected - Low Credit Score)">
      <ns0:incoming>Flow_Eligibility_Reject</ns0:incoming>
    </ns0:endEvent>
    <ns0:scriptTask id="Activity_GenerateLoanOffer" name="Generate Formal Loan Offer" scriptFormat="FEEL">
      <ns0:extensionElements>
        <ns2:script expression="= {loanId: application.id, approvedAmount: approvedAmount, interestRate: interestRate}" resultVariable="loanOffer" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Eligibility_AutoApprove</ns0:incoming>
      <ns0:incoming>Flow_Underwriting_To_Offer</ns0:incoming>
      <ns0:outgoing>Flow_Offer_To_Send</ns0:outgoing>
      <ns0:script>= {loanId: application.id, approvedAmount: approvedAmount, interestRate: interestRate}</ns0:script>
    </ns0:scriptTask>
    <ns0:sendTask id="Activity_SendOffer" name="Send Loan Offer to Applicant">
      <ns0:extensionElements>
        <ns2:taskDefinition type="send-loan-offer" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Offer_To_Send</ns0:incoming>
      <ns0:outgoing>Flow_SendOffer_To_Accept</ns0:outgoing>
    </ns0:sendTask>
    <ns0:serviceTask id="Activity_CreateLoanAccount" name="Create Loan Account in Core Banking">
      <ns0:extensionElements>
        <ns2:taskDefinition type="create-loan-account" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_ESSign_Success</ns0:incoming>
      <ns0:outgoing>Flow_AccountCreated_To_Disburse</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:boundaryEvent id="Event_Comp_Account" name="Compensate Loan Account" attachedToRef="Activity_CreateLoanAccount">
      <ns0:compensateEventDefinition id="CompEventDef_Acc" />
    </ns0:boundaryEvent>
    <ns0:serviceTask id="Activity_ReverseLoanAccount" name="Reverse Loan Account Creation (L12)" isForCompensation="true">
      <ns0:extensionElements>
        <ns2:taskDefinition type="reverse-loan-account" />
      </ns0:extensionElements>
    </ns0:serviceTask>
    <ns0:serviceTask id="Activity_NotifyDisbursement" name="Send Disbursement Notification &amp; Welcome Kit">
      <ns0:extensionElements>
        <ns2:taskDefinition type="notify-disbursement" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Disburse_To_Notify</ns0:incoming>
      <ns0:outgoing>Flow_Notify_To_DisbursedEnd</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:endEvent id="Event_End_LoanDisbursed" name="End (Loan Successfully Disbursed)">
      <ns0:incoming>Flow_Notify_To_DisbursedEnd</ns0:incoming>
    </ns0:endEvent>

    
    <ns0:sequenceFlow id="Flow_Start_To_DocCheck" sourceRef="Event_Start_Application" targetRef="Activity_CheckDocCompleteness" />
    <ns0:sequenceFlow id="Flow_To_DocCompleteness" sourceRef="Activity_CheckDocCompleteness" targetRef="Gateway_DocCompleteness" />
    <ns0:sequenceFlow id="Flow_Docs_Complete" name="Complete" sourceRef="Gateway_DocCompleteness" targetRef="Gateway_ForkVerification"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= docsComplete = true</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Docs_Incomplete" name="Incomplete (L1)" sourceRef="Gateway_DocCompleteness" targetRef="Activity_RequestMissingDocs"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= docsComplete = false</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_To_UploadMissing" sourceRef="Activity_RequestMissingDocs" targetRef="Activity_UploadMissingDocs" />
    <ns0:sequenceFlow id="Flow_ResubmitDocs_To_Check" sourceRef="Activity_UploadMissingDocs" targetRef="Activity_CheckDocCompleteness" />
    <ns0:sequenceFlow id="Flow_DocTimer_To_Lapse" sourceRef="Event_Timer_DocMissing" targetRef="Event_End_Lapsed" />

    <ns0:sequenceFlow id="Flow_Fork_To_KYC" sourceRef="Gateway_ForkVerification" targetRef="Activity_VerifyKYC" />
    <ns0:sequenceFlow id="Flow_To_KYCResult" sourceRef="Activity_VerifyKYC" targetRef="Gateway_KYCResult" />
    <ns0:sequenceFlow id="Flow_KYC_Matched" name="KYC Match" sourceRef="Gateway_KYCResult" targetRef="Gateway_JoinVerification"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= kycMatched = true</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_KYC_Mismatch" name="Mismatch (L2)" sourceRef="Gateway_KYCResult" targetRef="Activity_ManualKYCResolution"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= kycMatched = false</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_To_ManualKYCDecision" sourceRef="Activity_ManualKYCResolution" targetRef="Gateway_ManualKYCDecision" />
    <ns0:sequenceFlow id="Flow_KYC_Resolved" name="Resolved" sourceRef="Gateway_ManualKYCDecision" targetRef="Gateway_JoinVerification"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= kycResolved = true</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_KYC_Unresolved" name="Unresolved" sourceRef="Gateway_ManualKYCDecision" targetRef="Event_End_KYCRejected"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= kycResolved = false</ns0:conditionExpression></ns0:sequenceFlow>

    <ns0:sequenceFlow id="Flow_Fork_To_Bureau" sourceRef="Gateway_ForkVerification" targetRef="Activity_RequestBureauScore" />
    <ns0:sequenceFlow id="Flow_Bureau_Success" name="Score Received" sourceRef="Activity_RequestBureauScore" targetRef="Gateway_JoinVerification" />
    <ns0:sequenceFlow id="Flow_To_BureauRetries" sourceRef="Event_Error_BureauAPI" targetRef="Gateway_BureauRetries" />
    <ns0:sequenceFlow id="Flow_Bureau_Retry" name="Retry &lt; 3" sourceRef="Gateway_BureauRetries" targetRef="Activity_RequestBureauScore"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= bureauRetries &lt; 3</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Bureau_MaxRetries" name="Max Retries (L4)" sourceRef="Gateway_BureauRetries" targetRef="Activity_ManualCreditCheck"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= bureauRetries &gt;= 3</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_ManualBureau_To_Join" sourceRef="Activity_ManualCreditCheck" targetRef="Gateway_JoinVerification" />

    <ns0:sequenceFlow id="Flow_Fork_To_Income" sourceRef="Gateway_ForkVerification" targetRef="Activity_VerifyIncome" />
    <ns0:sequenceFlow id="Flow_Income_To_Join" sourceRef="Activity_VerifyIncome" targetRef="Gateway_JoinVerification" />

    <ns0:sequenceFlow id="Flow_Join_To_Fraud" sourceRef="Gateway_JoinVerification" targetRef="Activity_FraudScreening" />
    <ns0:sequenceFlow id="Flow_To_FraudOutcome" sourceRef="Activity_FraudScreening" targetRef="Gateway_FraudOutcome" />
    <ns0:sequenceFlow id="Flow_Fraud_Clean" name="No Flag" sourceRef="Gateway_FraudOutcome" targetRef="Activity_AssessEligibility"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= fraudPassed = true</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Fraud_Hit" name="Sanctions / AML Hit (L3)" sourceRef="Gateway_FraudOutcome" targetRef="SubProcess_FraudInvestigation"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= fraudPassed = false</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Fraud_To_End" sourceRef="SubProcess_FraudInvestigation" targetRef="Event_End_TerminatedFraud" />

    <ns0:sequenceFlow id="Flow_To_EligibilityOutcome" sourceRef="Activity_AssessEligibility" targetRef="Gateway_EligibilityOutcome" />
    <ns0:sequenceFlow id="Flow_Eligibility_AutoApprove" name="Auto-Approve" sourceRef="Gateway_EligibilityOutcome" targetRef="Activity_GenerateLoanOffer"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= riskTier = "LOW"</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Eligibility_Manual" name="Manual Review" sourceRef="Gateway_EligibilityOutcome" targetRef="Activity_UnderwriterReview"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= riskTier = "MEDIUM"</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Eligibility_Counter" name="Counter-Offer (L5, L6)" sourceRef="Gateway_EligibilityOutcome" targetRef="Activity_PrepareCounterOffer"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= riskTier = "COUNTER_OFFER"</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Eligibility_Reject" name="Reject Score" sourceRef="Gateway_EligibilityOutcome" targetRef="Event_End_ScoreRejected"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= riskTier = "HIGH"</ns0:conditionExpression></ns0:sequenceFlow>

    <ns0:sequenceFlow id="Flow_To_ReviewCounterOffer" sourceRef="Activity_PrepareCounterOffer" targetRef="Activity_ReviewCounterOffer" />
    <ns0:sequenceFlow id="Flow_To_CounterDecision" sourceRef="Activity_ReviewCounterOffer" targetRef="Gateway_CounterOfferAcceptance" />
    <ns0:sequenceFlow id="Flow_Counter_Accepted" name="Accepted" sourceRef="Gateway_CounterOfferAcceptance" targetRef="Activity_AssessEligibility"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= counterOfferAccepted = true</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Counter_Declined" name="Declined" sourceRef="Gateway_CounterOfferAcceptance" targetRef="Event_End_CounterDeclined"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= counterOfferAccepted = false</ns0:conditionExpression></ns0:sequenceFlow>

    <ns0:sequenceFlow id="Flow_Underwriter_To_Checks" sourceRef="Activity_UnderwriterReview" targetRef="Gateway_AdditionalChecks" />
    <ns0:sequenceFlow id="Flow_Checks_To_SeniorCommittee" name="Senior Committee (L7)" sourceRef="Gateway_AdditionalChecks" targetRef="Activity_SeniorCommitteeApproval"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= requiresSeniorCommittee = true</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Checks_To_Collateral" name="Secured Loan (L8)" sourceRef="Gateway_AdditionalChecks" targetRef="Activity_CollateralValuation"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= isSecuredLoan = true</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Checks_Standard" name="Standard" sourceRef="Gateway_AdditionalChecks" targetRef="Gateway_JoinUnderwriting"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= isStandardLoan = true</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Senior_To_Join" sourceRef="Activity_SeniorCommitteeApproval" targetRef="Gateway_JoinUnderwriting" />
    <ns0:sequenceFlow id="Flow_To_CollateralOutcome" sourceRef="Activity_CollateralValuation" targetRef="Gateway_CollateralOutcome" />
    <ns0:sequenceFlow id="Flow_Collateral_Approved" name="Valuation Approved" sourceRef="Gateway_CollateralOutcome" targetRef="Gateway_JoinUnderwriting"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= collateralApproved = true</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Collateral_TitleIssue" name="Title Issues (Reject)" sourceRef="Gateway_CollateralOutcome" targetRef="Event_End_TitleRejected"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= collateralApproved = false</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Underwriting_To_Offer" sourceRef="Gateway_JoinUnderwriting" targetRef="Activity_GenerateLoanOffer" />

    <ns0:sequenceFlow id="Flow_Offer_To_Send" sourceRef="Activity_GenerateLoanOffer" targetRef="Activity_SendOffer" />
    <ns0:sequenceFlow id="Flow_SendOffer_To_Accept" sourceRef="Activity_SendOffer" targetRef="Activity_AcceptOffer" />
    <ns0:sequenceFlow id="Flow_OfferExpired_To_End" sourceRef="Event_Timer_OfferExpiry" targetRef="Event_End_OfferExpired" />
    <ns0:sequenceFlow id="Flow_Accept_To_ESign" sourceRef="Activity_AcceptOffer" targetRef="Activity_ESignAgreement" />

    <ns0:sequenceFlow id="Flow_ESign_To_AttemptCheck" sourceRef="Activity_ESignAgreement" targetRef="Gateway_ESignAttempts" />
    <ns0:sequenceFlow id="Flow_ESSign_Success" name="Signed" sourceRef="Gateway_ESignAttempts" targetRef="Activity_CreateLoanAccount"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= eSignStatus = "SIGNED"</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_ESign_Retry" name="Resend &amp; Remind (Max 2)" sourceRef="Gateway_ESignAttempts" targetRef="Activity_ESignAgreement"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= eSignStatus = "RETRY"</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_ESign_Failed" name="Failed &gt; 2 (L11)" sourceRef="Gateway_ESignAttempts" targetRef="Event_End_ESignCancelled"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= eSignStatus = "FAILED"</ns0:conditionExpression></ns0:sequenceFlow>

    <ns0:sequenceFlow id="Flow_AccountCreated_To_Disburse" sourceRef="Activity_CreateLoanAccount" targetRef="Activity_DisburseFunds" />
    <ns0:sequenceFlow id="Flow_Disburse_To_Notify" sourceRef="Activity_DisburseFunds" targetRef="Activity_NotifyDisbursement" />
    <ns0:sequenceFlow id="Flow_Notify_To_DisbursedEnd" sourceRef="Activity_NotifyDisbursement" targetRef="Event_End_LoanDisbursed" />

    <ns0:sequenceFlow id="Flow_To_ResolveDisbursement" sourceRef="Event_Error_DisbursementFail" targetRef="Activity_ResolveDisbursementIssue" />
    <ns0:sequenceFlow id="Flow_To_DisburseRetryDecision" sourceRef="Activity_ResolveDisbursementIssue" targetRef="Gateway_DisburseRetryDecision" />
    <ns0:sequenceFlow id="Flow_Disbursement_Retry" name="Retry Verified" sourceRef="Gateway_DisburseRetryDecision" targetRef="Activity_DisburseFunds"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= accountVerified = true</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Disbursement_FailFinal" name="Unresolved (L12)" sourceRef="Gateway_DisburseRetryDecision" targetRef="Event_Throw_CompensateAccount"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= accountVerified = false</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_To_DisbursementFailEnd" sourceRef="Event_Throw_CompensateAccount" targetRef="Event_End_DisbursementFailed" />

    <ns0:sequenceFlow id="Flow_Withdrawal_To_Comp" sourceRef="Event_Message_Withdrawal" targetRef="Event_Throw_WithdrawCompensation" />
    <ns0:sequenceFlow id="Flow_To_WithdrawnEnd" sourceRef="Event_Throw_WithdrawCompensation" targetRef="Event_End_Withdrawn" />
  </ns0:process>

  <ns0:error id="Error_BureauDown" name="Error_BureauDown" errorCode="ERR_BUREAU_DOWN" />
  <ns0:error id="Error_PaymentGateway" name="Error_PaymentGateway" errorCode="ERR_PAYMENT_GATEWAY" />
  <ns0:message id="Message_ApplicationSubmitted" name="Message_ApplicationSubmitted" />
  <ns0:message id="Message_WithdrawLoan" name="Message_WithdrawLoan" />

  <ns4:BPMNDiagram id="BPMNDiagram_LoanOrigination">
    <ns4:BPMNPlane id="BPMNPlane_LoanOrigination" bpmnElement="Collaboration_LoanOrigination">
      
