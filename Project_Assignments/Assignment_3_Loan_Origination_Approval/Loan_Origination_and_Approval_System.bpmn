        <ns5:Bounds x="190" y="850" width="2420" height="220" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Lane_Operations_di" bpmnElement="Lane_Operations" isHorizontal="true">
        <ns5:Bounds x="190" y="1070" width="2420" height="230" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Lane_CoreBanking_di" bpmnElement="Lane_CoreBanking" isHorizontal="true">
