      </ns4:BPMNShape>
      <ns4:BPMNShape id="Event_End_OfferExpired_di" bpmnElement="Event_End_OfferExpired">
        <ns5:Bounds x="2062" y="312" width="36" height="36" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="2046" y="355" width="68" height="27" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Activity_ESignAgreement_di" bpmnElement="Activity_ESignAgreement">
        <ns5:Bounds x="2050" y="250" width="120" height="80" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Gateway_ESignAttempts_di" bpmnElement="Gateway_ESignAttempts" isMarkerVisible="true">
        <ns5:Bounds x="2205" y="265" width="50" height="50" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="2191" y="228" width="79" height="27" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Event_End_ESignCancelled_di" bpmnElement="Event_End_ESignCancelled">
        <ns5:Bounds x="2302" y="272" width="36" height="36" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="2281" y="315" width="79" height="40" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Event_End_Withdrawn_di" bpmnElement="Event_End_Withdrawn">
        <ns5:Bounds x="1802" y="212" width="36" height="36" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="1787" y="255" width="67" height="27" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>

      
      <ns4:BPMNShape id="Activity_ManualKYCResolution_di" bpmnElement="Activity_ManualKYCResolution">
        <ns5:Bounds x="640" y="470" width="120" height="80" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Gateway_ManualKYCDecision_di" bpmnElement="Gateway_ManualKYCDecision" isMarkerVisible="true">
        <ns5:Bounds x="795" y="485" width="50" height="50" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="781" y="542" width="78" height="14" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Event_End_KYCRejected_di" bpmnElement="Event_End_KYCRejected">
        <ns5:Bounds x="892" y="492" width="36" height="36" />
        <ns4:BPMNLabel>
          <ns5:Bounds x="876" y="535" width="68" height="40" />
        </ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Activity_ManualCreditCheck_di" bpmnElement="Activity_ManualCreditCheck">
        <ns5:Bounds x="840" y="470" width="120" height="80" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Activity_VerifyIncome_di" bpmnElement="Activity_VerifyIncome">
        <ns5:Bounds x="740" y="550" width="120" height="60" />
