<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://camunda.org/schema/modeler/1.0" xmlns:ns2="http://camunda.org/schema/zeebe/1.0" xmlns:ns4="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns5="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns6="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_StudentProjectAllocation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.9.0">
  <ns0:collaboration id="Collaboration_StudentProjectAllocation">
    <ns0:participant id="Participant_Department" name="Student Project Approval &amp; Allocation System" processRef="Process_StudentProjectAllocation" />
  </ns0:collaboration>
  <ns0:process id="Process_StudentProjectAllocation" name="Student Project Approval &amp; Allocation System" isExecutable="true">
    <ns0:laneSet id="LaneSet_Department">
      <ns0:lane id="Lane_Student" name="Student / Team">
        <ns0:flowNodeRef>Event_Start</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_SubmitProposal</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_Timer_ProposalDeadline</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_ResubmitProposal</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_ReviseProposal</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_Lapsed</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Coordinator" name="Project Coordinator">
        <ns0:flowNodeRef>Activity_HandleLateSubmission</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_LateDecision</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_EscalateToCoordinator</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_ScreenProposal</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_ReviewDuplicate</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_DuplicateDecision</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_Plagiarized</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_ManualGuideAllocation</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_ManualNotification</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Committee" name="Review Committee (incl. HoD)">
        <ns0:flowNodeRef>Activity_EvaluateProposal</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_Timer_ReviewReminder</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_Timer_SLAEscalation</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_HoDEscalation</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_CommitteeDecision</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_RevisionCycles</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Guide" name="Faculty Guide">
        <ns0:flowNodeRef>SubProcess_GuideAllocation</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_Message_Withdrawal</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_Withdrawn</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_System" name="Project Management System">
        <ns0:flowNodeRef>Activity_ValidateProposal</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_ValidationOutcome</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_NotifyInvalidTeam</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_InvalidTeam</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_ReturnErrorList</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_CheckAttempts</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_CheckSimilarity</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_SimilarityOutcome</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_SendReviewReminder</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_ReminderSent</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_SendRejectionReasons</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_AllowNewTopic</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_Rejected</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_MatchGuide</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_GuideMatchOutcome</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_NotifyStudentAndRecord</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_Error_NotificationFailure</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_End_Allocated</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>

    
    <ns0:startEvent id="Event_Start" name="Student Team Decides to Submit Proposal">
      <ns0:outgoing>Flow_Start_To_Submit</ns0:outgoing>
    </ns0:startEvent>
    <ns0:userTask id="Activity_SubmitProposal" name="Submit Project Proposal">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Start_To_Submit</ns0:incoming>
      <ns0:incoming>Flow_Late_Approved</ns0:incoming>
      <ns0:incoming>Flow_Duplicate_Modify</ns0:incoming>
      <ns0:incoming>Flow_NewTopic_Yes</ns0:incoming>
      <ns0:outgoing>Flow_Submit_To_Validate</ns0:outgoing>
    </ns0:userTask>
    <ns0:boundaryEvent id="Event_Timer_ProposalDeadline" name="Submission Deadline Passed (F4)" attachedToRef="Activity_SubmitProposal">
      <ns0:outgoing>Flow_Deadline_To_Coordinator</ns0:outgoing>
      <ns0:timerEventDefinition id="TimerEventDef_Deadline">
        <ns0:timeDuration xsi:type="bpmn:tFormalExpression">P14D</ns0:timeDuration>
      </ns0:timerEventDefinition>
    </ns0:boundaryEvent>
    <ns0:userTask id="Activity_ResubmitProposal" name="Resubmit Corrected Proposal">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Attempts_UnderLimit</ns0:incoming>
      <ns0:incoming>Flow_Escalation_Resolved</ns0:incoming>
      <ns0:outgoing>Flow_Resubmit_To_Validate</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Activity_ReviseProposal" name="Revise Proposal within 7-Day Window (F5)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Committee_Revise</ns0:incoming>
      <ns0:outgoing>Flow_Revise_To_CycleCheck</ns0:outgoing>
    </ns0:userTask>
    <ns0:endEvent id="Event_End_Lapsed" name="Proposal Closed / Lapsed">
      <ns0:incoming>Flow_Late_Rejected</ns0:incoming>
    </ns0:endEvent>

    
    <ns0:userTask id="Activity_HandleLateSubmission" name="Review Late Submission Request (F4)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Deadline_To_Coordinator</ns0:incoming>
      <ns0:outgoing>Flow_To_LateDecision</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gateway_LateDecision" name="Late Submission Approved?">
      <ns0:incoming>Flow_To_LateDecision</ns0:incoming>
      <ns0:outgoing>Flow_Late_Approved</ns0:outgoing>
      <ns0:outgoing>Flow_Late_Rejected</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Activity_EscalateToCoordinator" name="Review Escalated Validation Errors (F1)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Attempts_OverLimit</ns0:incoming>
      <ns0:outgoing>Flow_Escalation_Resolved</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Activity_ScreenProposal" name="Coordinator Screens Proposal">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Validation_Passed</ns0:incoming>
      <ns0:outgoing>Flow_Screen_To_Similarity</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Activity_ReviewDuplicate" name="Review Duplicate Match (F3)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Similarity_Flagged</ns0:incoming>
      <ns0:outgoing>Flow_To_DuplicateDecision</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gateway_DuplicateDecision" name="Duplicate Resolution?">
      <ns0:incoming>Flow_To_DuplicateDecision</ns0:incoming>
      <ns0:outgoing>Flow_Duplicate_Modify</ns0:outgoing>
      <ns0:outgoing>Flow_Duplicate_Reject</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="Event_End_Plagiarized" name="Proposal Rejected (Plagiarism / Duplicate)">
      <ns0:incoming>Flow_Duplicate_Reject</ns0:incoming>
    </ns0:endEvent>
    <ns0:userTask id="Activity_ManualGuideAllocation" name="Allocate Guide Manually / Co-Guide / Waitlist (F8)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_GuideMatch_None</ns0:incoming>
      <ns0:incoming>Flow_Guide_MaxRetries</ns0:incoming>
      <ns0:outgoing>Flow_Manual_To_Notify</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Activity_ManualNotification" name="Send Manual Allocation Notification (F10)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Notification_Fallback</ns0:incoming>
      <ns0:outgoing>Flow_ManualNotify_To_End</ns0:outgoing>
    </ns0:userTask>

    
    <ns0:userTask id="Activity_EvaluateProposal" name="Review Committee Evaluates Proposal">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Similarity_Passed</ns0:incoming>
      <ns0:incoming>Flow_Cycle_Allowed</ns0:incoming>
      <ns0:incoming>Flow_HoD_To_Evaluate</ns0:incoming>
      <ns0:outgoing>Flow_Evaluate_To_Decision</ns0:outgoing>
    </ns0:userTask>
    <ns0:boundaryEvent id="Event_Timer_ReviewReminder" name="SLA Warning (Non-interrupting) (F7)" cancelActivity="false" attachedToRef="Activity_EvaluateProposal">
      <ns0:outgoing>Flow_To_SendReminder</ns0:outgoing>
      <ns0:timerEventDefinition id="TimerEventDef_Reminder">
        <ns0:timeDuration xsi:type="bpmn:tFormalExpression">P5D</ns0:timeDuration>
      </ns0:timerEventDefinition>
    </ns0:boundaryEvent>
    <ns0:boundaryEvent id="Event_Timer_SLAEscalation" name="SLA Exceeded Escalation (F7)" attachedToRef="Activity_EvaluateProposal">
      <ns0:outgoing>Flow_To_HoDEscalation</ns0:outgoing>
      <ns0:timerEventDefinition id="TimerEventDef_SLAEscalation">
        <ns0:timeDuration xsi:type="bpmn:tFormalExpression">P10D</ns0:timeDuration>
      </ns0:timerEventDefinition>
    </ns0:boundaryEvent>
    <ns0:userTask id="Activity_HoDEscalation" name="Escalate to HoD for Expedited Review (F7)">
      <ns0:extensionElements>
        <ns2:userTask />
      </ns0:extensionElements>
      <ns0:incoming>Flow_To_HoDEscalation</ns0:incoming>
      <ns0:outgoing>Flow_HoD_To_Evaluate</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gateway_CommitteeDecision" name="Committee Decision?">
      <ns0:incoming>Flow_Evaluate_To_Decision</ns0:incoming>
      <ns0:outgoing>Flow_Committee_Approved</ns0:outgoing>
      <ns0:outgoing>Flow_Committee_Revise</ns0:outgoing>
      <ns0:outgoing>Flow_Committee_Rejected</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gateway_RevisionCycles" name="Revision Cycles &lt;= 2? (F5)">
      <ns0:incoming>Flow_Revise_To_CycleCheck</ns0:incoming>
      <ns0:outgoing>Flow_Cycle_Allowed</ns0:outgoing>
      <ns0:outgoing>Flow_Cycle_Exceeded</ns0:outgoing>
    </ns0:exclusiveGateway>

    
    <ns0:serviceTask id="Activity_ValidateProposal" name="Validate Form Completeness &amp; Team Rules">
      <ns0:extensionElements>
        <ns2:taskDefinition type="validate-proposal-rules" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Submit_To_Validate</ns0:incoming>
      <ns0:incoming>Flow_Resubmit_To_Validate</ns0:incoming>
      <ns0:outgoing>Flow_To_ValidationOutcome</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gateway_ValidationOutcome" name="Validation Result?">
      <ns0:incoming>Flow_To_ValidationOutcome</ns0:incoming>
      <ns0:outgoing>Flow_Validation_Passed</ns0:outgoing>
      <ns0:outgoing>Flow_Validation_TeamError</ns0:outgoing>
      <ns0:outgoing>Flow_Validation_FormErrors</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Activity_NotifyInvalidTeam" name="Notify Team Rule Violation (F2)">
      <ns0:extensionElements>
        <ns2:taskDefinition type="notify-invalid-team" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Validation_TeamError</ns0:incoming>
      <ns0:outgoing>Flow_To_InvalidTeamEnd</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:endEvent id="Event_End_InvalidTeam" name="End (Invalid Team)">
      <ns0:incoming>Flow_To_InvalidTeamEnd</ns0:incoming>
      <ns0:errorEventDefinition id="ErrorEventDef_InvalidTeam" errorRef="Error_InvalidTeam" />
    </ns0:endEvent>
    <ns0:serviceTask id="Activity_ReturnErrorList" name="Return Error List (F1)">
      <ns0:extensionElements>
        <ns2:taskDefinition type="generate-validation-errors" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Validation_FormErrors</ns0:incoming>
      <ns0:outgoing>Flow_To_CheckAttempts</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gateway_CheckAttempts" name="Resubmission Attempt &lt;= 2? (F1)">
      <ns0:incoming>Flow_To_CheckAttempts</ns0:incoming>
      <ns0:outgoing>Flow_Attempts_UnderLimit</ns0:outgoing>
      <ns0:outgoing>Flow_Attempts_OverLimit</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Activity_CheckSimilarity" name="Run Similarity / Duplicate-Topic Check">
      <ns0:extensionElements>
        <ns2:taskDefinition type="run-similarity-check" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Screen_To_Similarity</ns0:incoming>
      <ns0:outgoing>Flow_To_SimilarityOutcome</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gateway_SimilarityOutcome" name="Similarity Score High? (F3)">
      <ns0:incoming>Flow_To_SimilarityOutcome</ns0:incoming>
      <ns0:outgoing>Flow_Similarity_Passed</ns0:outgoing>
      <ns0:outgoing>Flow_Similarity_Flagged</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sendTask id="Activity_SendReviewReminder" name="Send Committee SLA Reminder (F7)">
      <ns0:extensionElements>
        <ns2:taskDefinition type="send-review-reminder" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_To_SendReminder</ns0:incoming>
      <ns0:outgoing>Flow_To_ReminderEnd</ns0:outgoing>
    </ns0:sendTask>
    <ns0:endEvent id="Event_End_ReminderSent" name="Reminder Logged">
      <ns0:incoming>Flow_To_ReminderEnd</ns0:incoming>
    </ns0:endEvent>
    <ns0:serviceTask id="Activity_SendRejectionReasons" name="Send Rejection Reasons to Student (F6)">
      <ns0:extensionElements>
        <ns2:taskDefinition type="send-rejection-reasons" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Committee_Rejected</ns0:incoming>
      <ns0:incoming>Flow_Cycle_Exceeded</ns0:incoming>
      <ns0:outgoing>Flow_To_AllowNewTopic</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gateway_AllowNewTopic" name="New Topic Allowed (1 Attempt)? (F6)">
      <ns0:incoming>Flow_To_AllowNewTopic</ns0:incoming>
      <ns0:outgoing>Flow_NewTopic_Yes</ns0:outgoing>
      <ns0:outgoing>Flow_NewTopic_No</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:endEvent id="Event_End_Rejected" name="End (Proposal Rejected)">
      <ns0:incoming>Flow_NewTopic_No</ns0:incoming>
    </ns0:endEvent>
    <ns0:businessRuleTask id="Activity_MatchGuide" name="Check Guide Availability &amp; Workload (F8)">
      <ns0:extensionElements>
        <ns2:calledDecision decisionId="check-guide-availability" resultVariable="guideMatchResult" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_Committee_Approved</ns0:incoming>
      <ns0:incoming>Flow_Decline_Retry</ns0:incoming>
      <ns0:outgoing>Flow_To_GuideMatchOutcome</ns0:outgoing>
    </ns0:businessRuleTask>
    <ns0:exclusiveGateway id="Gateway_GuideMatchOutcome" name="Guide Available? (F8)">
      <ns0:incoming>Flow_To_GuideMatchOutcome</ns0:incoming>
      <ns0:outgoing>Flow_GuideMatch_Found</ns0:outgoing>
      <ns0:outgoing>Flow_GuideMatch_None</ns0:outgoing>
    </ns0:exclusiveGateway>

    
    <ns0:subProcess id="SubProcess_GuideAllocation" name="Faculty Guide Allocation &amp; Acceptance">
      <ns0:incoming>Flow_GuideMatch_Found</ns0:incoming>
      <ns0:outgoing>Flow_AllocSub_To_Notify</ns0:outgoing>
      <ns0:startEvent id="SubEvent_Start" name="Start Allocation">
        <ns0:outgoing>SubFlow_1</ns0:outgoing>
      </ns0:startEvent>
      <ns0:serviceTask id="Activity_ReserveSlot" name="Reserve Guide Quota Slot">
        <ns0:extensionElements>
          <ns2:taskDefinition type="reserve-guide-slot" />
        </ns0:extensionElements>
        <ns0:incoming>SubFlow_1</ns0:incoming>
        <ns0:outgoing>SubFlow_2</ns0:outgoing>
      </ns0:serviceTask>
      <ns0:boundaryEvent id="Event_Comp_Slot" name="Compensate Slot Reservation" attachedToRef="Activity_ReserveSlot">
        <ns0:compensateEventDefinition id="CompEventDef_Slot" />
      </ns0:boundaryEvent>
      <ns0:serviceTask id="Activity_ReleaseSlot" name="Release Guide Quota Slot (F11)" isForCompensation="true">
        <ns0:extensionElements>
          <ns2:taskDefinition type="release-guide-slot" />
        </ns0:extensionElements>
      </ns0:serviceTask>
      <ns0:sendTask id="Activity_SendAllocationRequest" name="Send Allocation Request to Guide">
        <ns0:extensionElements>
          <ns2:taskDefinition type="send-guide-request" />
        </ns0:extensionElements>
        <ns0:incoming>SubFlow_2</ns0:incoming>
        <ns0:outgoing>SubFlow_3</ns0:outgoing>
      </ns0:sendTask>
      <ns0:userTask id="Activity_GuideRespond" name="Guide Reviews Request (Accept / Decline)">
        <ns0:extensionElements>
          <ns2:userTask />
        </ns0:extensionElements>
        <ns0:incoming>SubFlow_3</ns0:incoming>
        <ns0:outgoing>SubFlow_4</ns0:outgoing>
      </ns0:userTask>
      <ns0:boundaryEvent id="Event_Timer_GuideSilent" name="Guide Silent (3 Days) (F9)" attachedToRef="Activity_GuideRespond">
        <ns0:outgoing>SubFlow_Timeout</ns0:outgoing>
        <ns0:timerEventDefinition id="TimerEventDef_GuideSilent">
          <ns0:timeDuration xsi:type="bpmn:tFormalExpression">P3D</ns0:timeDuration>
        </ns0:timerEventDefinition>
      </ns0:boundaryEvent>
      <ns0:exclusiveGateway id="SubGateway_Decision" name="Guide Accepted?">
        <ns0:incoming>SubFlow_4</ns0:incoming>
        <ns0:outgoing>SubFlow_Accept</ns0:outgoing>
        <ns0:outgoing>SubFlow_Decline</ns0:outgoing>
      </ns0:exclusiveGateway>
      <ns0:endEvent id="SubEvent_EndSuccess" name="Allocation Accepted">
        <ns0:incoming>SubFlow_Accept</ns0:incoming>
      </ns0:endEvent>
      <ns0:endEvent id="SubEvent_EndDecline" name="Guide Declined / Unresponsive (F9)">
        <ns0:incoming>SubFlow_Decline</ns0:incoming>
        <ns0:incoming>SubFlow_Timeout</ns0:incoming>
        <ns0:errorEventDefinition id="ErrorEventDef_GuideDecline" errorRef="Error_GuideDecline" />
      </ns0:endEvent>
      <ns0:sequenceFlow id="SubFlow_1" sourceRef="SubEvent_Start" targetRef="Activity_ReserveSlot" />
      <ns0:sequenceFlow id="SubFlow_2" sourceRef="Activity_ReserveSlot" targetRef="Activity_SendAllocationRequest" />
      <ns0:sequenceFlow id="SubFlow_3" sourceRef="Activity_SendAllocationRequest" targetRef="Activity_GuideRespond" />
      <ns0:sequenceFlow id="SubFlow_4" sourceRef="Activity_GuideRespond" targetRef="SubGateway_Decision" />
      <ns0:sequenceFlow id="SubFlow_Accept" name="Yes" sourceRef="SubGateway_Decision" targetRef="SubEvent_EndSuccess"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= guideResponse = "ACCEPT"</ns0:conditionExpression></ns0:sequenceFlow>
      <ns0:sequenceFlow id="SubFlow_Decline" name="No" sourceRef="SubGateway_Decision" targetRef="SubEvent_EndDecline"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= guideResponse = "DECLINE"</ns0:conditionExpression></ns0:sequenceFlow>
      <ns0:sequenceFlow id="SubFlow_Timeout" sourceRef="Event_Timer_GuideSilent" targetRef="SubEvent_EndDecline" />
    </ns0:subProcess>

    <ns0:boundaryEvent id="Event_Error_GuideDecline" name="Guide Unavailable / Declined (F9)" attachedToRef="SubProcess_GuideAllocation">
      <ns0:outgoing>Flow_To_GuideDeclineCheck</ns0:outgoing>
      <ns0:errorEventDefinition id="ErrorEventDef_CatchDecline" errorRef="Error_GuideDecline" />
    </ns0:boundaryEvent>
    <ns0:exclusiveGateway id="Gateway_GuideDeclineAttempts" name="Decline Attempts &lt; 3? (F9)">
      <ns0:incoming>Flow_To_GuideDeclineCheck</ns0:incoming>
      <ns0:outgoing>Flow_Decline_Retry</ns0:outgoing>
      <ns0:outgoing>Flow_Guide_MaxRetries</ns0:outgoing>
    </ns0:exclusiveGateway>

    <ns0:boundaryEvent id="Event_Message_Withdrawal" name="Withdrawal Request Received (F11)" attachedToRef="SubProcess_GuideAllocation">
      <ns0:outgoing>Flow_To_CompensationThrow</ns0:outgoing>
      <ns0:messageEventDefinition id="MessageEventDef_Withdrawal" messageRef="Message_Withdrawal" />
    </ns0:boundaryEvent>
    <ns0:intermediateThrowEvent id="Event_Throw_CompensateSlot" name="Trigger Slot Release Compensation (F11)">
      <ns0:incoming>Flow_To_CompensationThrow</ns0:incoming>
      <ns0:outgoing>Flow_To_WithdrawnEnd</ns0:outgoing>
      <ns0:compensateEventDefinition id="CompEventDef_Throw" />
    </ns0:intermediateThrowEvent>
    <ns0:endEvent id="Event_End_Withdrawn" name="End (Project Withdrawn)">
      <ns0:incoming>Flow_To_WithdrawnEnd</ns0:incoming>
    </ns0:endEvent>

    
    <ns0:sendTask id="Activity_NotifyStudentAndRecord" name="Notify Student &amp; Record Allocation in System">
      <ns0:extensionElements>
        <ns2:taskDefinition type="notify-student-and-record" />
      </ns0:extensionElements>
      <ns0:incoming>Flow_AllocSub_To_Notify</ns0:incoming>
      <ns0:incoming>Flow_Manual_To_Notify</ns0:incoming>
      <ns0:outgoing>Flow_Notify_To_End</ns0:outgoing>
    </ns0:sendTask>
    <ns0:boundaryEvent id="Event_Error_NotificationFailure" name="Notification / DB Write Error (F10)" attachedToRef="Activity_NotifyStudentAndRecord">
      <ns0:outgoing>Flow_Notification_Fallback</ns0:outgoing>
      <ns0:errorEventDefinition id="ErrorEventDef_NotificationFailure" errorRef="Error_NotificationFailure" />
    </ns0:boundaryEvent>
    <ns0:endEvent id="Event_End_Allocated" name="End (Project Allocated &amp; Confirmed)">
      <ns0:incoming>Flow_Notify_To_End</ns0:incoming>
      <ns0:incoming>Flow_ManualNotify_To_End</ns0:incoming>
    </ns0:endEvent>

    
    <ns0:sequenceFlow id="Flow_Start_To_Submit" sourceRef="Event_Start" targetRef="Activity_SubmitProposal" />
    <ns0:sequenceFlow id="Flow_Submit_To_Validate" sourceRef="Activity_SubmitProposal" targetRef="Activity_ValidateProposal" />
    <ns0:sequenceFlow id="Flow_Deadline_To_Coordinator" sourceRef="Event_Timer_ProposalDeadline" targetRef="Activity_HandleLateSubmission" />
    <ns0:sequenceFlow id="Flow_To_LateDecision" sourceRef="Activity_HandleLateSubmission" targetRef="Gateway_LateDecision" />
    <ns0:sequenceFlow id="Flow_Late_Approved" name="Approve Late" sourceRef="Gateway_LateDecision" targetRef="Activity_SubmitProposal"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= lateApproved = true</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Late_Rejected" name="Reject Late" sourceRef="Gateway_LateDecision" targetRef="Event_End_Lapsed"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= lateApproved = false</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_To_ValidationOutcome" sourceRef="Activity_ValidateProposal" targetRef="Gateway_ValidationOutcome" />
    <ns0:sequenceFlow id="Flow_Validation_Passed" name="Valid" sourceRef="Gateway_ValidationOutcome" targetRef="Activity_ScreenProposal"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= validationStatus = "VALID"</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Validation_TeamError" name="Invalid Team Rules (F2)" sourceRef="Gateway_ValidationOutcome" targetRef="Activity_NotifyInvalidTeam"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= validationStatus = "INVALID_TEAM"</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_To_InvalidTeamEnd" sourceRef="Activity_NotifyInvalidTeam" targetRef="Event_End_InvalidTeam" />
    <ns0:sequenceFlow id="Flow_Validation_FormErrors" name="Missing / Form Errors (F1)" sourceRef="Gateway_ValidationOutcome" targetRef="Activity_ReturnErrorList"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= validationStatus = "FORM_ERRORS"</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_To_CheckAttempts" sourceRef="Activity_ReturnErrorList" targetRef="Gateway_CheckAttempts" />
    <ns0:sequenceFlow id="Flow_Attempts_UnderLimit" name="Attempts &lt;= 2" sourceRef="Gateway_CheckAttempts" targetRef="Activity_ResubmitProposal"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= resubmitAttempts &lt;= 2</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Resubmit_To_Validate" sourceRef="Activity_ResubmitProposal" targetRef="Activity_ValidateProposal" />
    <ns0:sequenceFlow id="Flow_Attempts_OverLimit" name="Attempts &gt; 2 (Escalate)" sourceRef="Gateway_CheckAttempts" targetRef="Activity_EscalateToCoordinator"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= resubmitAttempts &gt; 2</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Escalation_Resolved" sourceRef="Activity_EscalateToCoordinator" targetRef="Activity_ResubmitProposal" />
    <ns0:sequenceFlow id="Flow_Screen_To_Similarity" sourceRef="Activity_ScreenProposal" targetRef="Activity_CheckSimilarity" />
    <ns0:sequenceFlow id="Flow_To_SimilarityOutcome" sourceRef="Activity_CheckSimilarity" targetRef="Gateway_SimilarityOutcome" />
    <ns0:sequenceFlow id="Flow_Similarity_Passed" name="Passed" sourceRef="Gateway_SimilarityOutcome" targetRef="Activity_EvaluateProposal"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= similarityScore &lt; 25</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Similarity_Flagged" name="High Similarity (F3)" sourceRef="Gateway_SimilarityOutcome" targetRef="Activity_ReviewDuplicate"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= similarityScore &gt;= 25</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_To_DuplicateDecision" sourceRef="Activity_ReviewDuplicate" targetRef="Gateway_DuplicateDecision" />
    <ns0:sequenceFlow id="Flow_Duplicate_Modify" name="Request Topic Modification" sourceRef="Gateway_DuplicateDecision" targetRef="Activity_SubmitProposal"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= duplicateResolution = "MODIFY"</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Duplicate_Reject" name="Reject Duplicate" sourceRef="Gateway_DuplicateDecision" targetRef="Event_End_Plagiarized"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= duplicateResolution = "REJECT"</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_To_SendReminder" sourceRef="Event_Timer_ReviewReminder" targetRef="Activity_SendReviewReminder" />
    <ns0:sequenceFlow id="Flow_To_ReminderEnd" sourceRef="Activity_SendReviewReminder" targetRef="Event_End_ReminderSent" />
    <ns0:sequenceFlow id="Flow_To_HoDEscalation" sourceRef="Event_Timer_SLAEscalation" targetRef="Activity_HoDEscalation" />
    <ns0:sequenceFlow id="Flow_HoD_To_Evaluate" sourceRef="Activity_HoDEscalation" targetRef="Activity_EvaluateProposal" />
    <ns0:sequenceFlow id="Flow_Evaluate_To_Decision" sourceRef="Activity_EvaluateProposal" targetRef="Gateway_CommitteeDecision" />
    <ns0:sequenceFlow id="Flow_Committee_Approved" name="Approved" sourceRef="Gateway_CommitteeDecision" targetRef="Activity_MatchGuide"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= committeeDecision = "APPROVED"</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Committee_Revise" name="Revise (F5)" sourceRef="Gateway_CommitteeDecision" targetRef="Activity_ReviseProposal"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= committeeDecision = "REVISE"</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Revise_To_CycleCheck" sourceRef="Activity_ReviseProposal" targetRef="Gateway_RevisionCycles" />
    <ns0:sequenceFlow id="Flow_Cycle_Allowed" name="Cycles &lt;= 2" sourceRef="Gateway_RevisionCycles" targetRef="Activity_EvaluateProposal"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= revisionCycles &lt;= 2</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Cycle_Exceeded" name="Cycles &gt; 2 (Reject)" sourceRef="Gateway_RevisionCycles" targetRef="Activity_SendRejectionReasons"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= revisionCycles &gt; 2</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Committee_Rejected" name="Rejected (F6)" sourceRef="Gateway_CommitteeDecision" targetRef="Activity_SendRejectionReasons"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= committeeDecision = "REJECTED"</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_To_AllowNewTopic" sourceRef="Activity_SendRejectionReasons" targetRef="Gateway_AllowNewTopic" />
    <ns0:sequenceFlow id="Flow_NewTopic_Yes" name="Yes (1 Chance)" sourceRef="Gateway_AllowNewTopic" targetRef="Activity_SubmitProposal"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= allowNewTopic = true</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_NewTopic_No" name="No" sourceRef="Gateway_AllowNewTopic" targetRef="Event_End_Rejected"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= allowNewTopic = false</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_To_GuideMatchOutcome" sourceRef="Activity_MatchGuide" targetRef="Gateway_GuideMatchOutcome" />
    <ns0:sequenceFlow id="Flow_GuideMatch_Found" name="Guide Available" sourceRef="Gateway_GuideMatchOutcome" targetRef="SubProcess_GuideAllocation"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= guideMatchFound = true</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_GuideMatch_None" name="None (F8)" sourceRef="Gateway_GuideMatchOutcome" targetRef="Activity_ManualGuideAllocation"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= guideMatchFound = false</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Manual_To_Notify" sourceRef="Activity_ManualGuideAllocation" targetRef="Activity_NotifyStudentAndRecord" />
    <ns0:sequenceFlow id="Flow_AllocSub_To_Notify" sourceRef="SubProcess_GuideAllocation" targetRef="Activity_NotifyStudentAndRecord" />
    <ns0:sequenceFlow id="Flow_To_GuideDeclineCheck" sourceRef="Event_Error_GuideDecline" targetRef="Gateway_GuideDeclineAttempts" />
    <ns0:sequenceFlow id="Flow_Decline_Retry" name="Attempts &lt; 3" sourceRef="Gateway_GuideDeclineAttempts" targetRef="Activity_MatchGuide"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= guideDeclineAttempts &lt; 3</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_Guide_MaxRetries" name="Attempts &gt;= 3" sourceRef="Gateway_GuideDeclineAttempts" targetRef="Activity_ManualGuideAllocation"><ns0:conditionExpression xsi:type="bpmn:tFormalExpression">= guideDeclineAttempts &gt;= 3</ns0:conditionExpression></ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_To_CompensationThrow" sourceRef="Event_Message_Withdrawal" targetRef="Event_Throw_CompensateSlot" />
    <ns0:sequenceFlow id="Flow_To_WithdrawnEnd" sourceRef="Event_Throw_CompensateSlot" targetRef="Event_End_Withdrawn" />
    <ns0:sequenceFlow id="Flow_Notify_To_End" sourceRef="Activity_NotifyStudentAndRecord" targetRef="Event_End_Allocated" />
    <ns0:sequenceFlow id="Flow_Notification_Fallback" sourceRef="Event_Error_NotificationFailure" targetRef="Activity_ManualNotification" />
    <ns0:sequenceFlow id="Flow_ManualNotify_To_End" sourceRef="Activity_ManualNotification" targetRef="Event_End_Allocated" />
  </ns0:process>

