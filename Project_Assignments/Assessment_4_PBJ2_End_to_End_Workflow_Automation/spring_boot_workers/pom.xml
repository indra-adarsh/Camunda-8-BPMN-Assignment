<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>

    <groupId>com.camunda.pbj2</groupId>
    <artifactId>camunda8-pbj2-workers</artifactId>
    <version>1.0.0</version>
    <name>camunda8-pbj2-workers</name>
    <description>Camunda 8 External Job Workers and Mock REST APIs for PBJ-2 Practical Assignment (Labs 1-3)</description>

    <properties>
        <java.version>17</java.version>
        <zeebe.version>8.5.2</zeebe.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Web for Mock REST APIs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Camunda 8 Zeebe Spring Client Starter -->
        <dependency>
            <groupId>io.camunda</groupId>
            <artifactId>camunda-zeebe-spring-boot-starter</artifactId>
            <version>${zeebe.version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
