    {
      "id": "A1_SCENARIO_01_HAPPY_PATH",
      "name": "Happy Path: Seamless Approval & Guide Allocation",
      "description": "Valid team and form, low similarity (<25%), committee approves, guide matches on domain, guide accepts within 3 days, and student is notified.",
      "initialVariables": {
        "projectTitle": "Autonomous Drone Fleet Coordination",
        "teamMembers": [
          "CS201",
          "CS202",
          "CS203"
        ],
        "teamSize": 3,
        "domain": "Artificial Intelligence & Robotics",
        "abstractText": "This project investigates multi-agent reinforcement learning for autonomous drone fleet navigation and collision avoidance in GPS-denied environments.",
        "lateSubmission": false
      },
      "taskDecisions": [
        {
          "task": "Activity_ValidateProposal",
          "output": {
            "validationStatus": "VALID"
          }
        },
        {
          "task": "Activity_ScreenProposal",
          "output": {
            "screenPassed": true
          }
        },
        {
          "task": "Activity_CheckSimilarity",
          "output": {
            "similarityScore": 12.5
          }
        },
        {
          "task": "Activity_EvaluateProposal",
          "output": {
            "committeeDecision": "APPROVED"
          }
        },
        {
          "task": "Activity_MatchGuide",
          "output": {
            "guideMatchFound": true,
            "allocatedGuideId": "PROF_ALAN_TURING",
            "guideCapacityAvailable": true
