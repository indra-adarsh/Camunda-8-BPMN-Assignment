        {
          "task": "Activity_ReserveSlot",
          "output": {
            "slotReserved": true
          }
        },
        {
          "task": "Activity_GuideRespond",
          "output": {
            "guideResponse": "ACCEPT"
          }
        },
        {
          "task": "Activity_NotifyStudentAndRecord",
          "output": {
            "studentNotified": true,
            "recordSaved": true
          }
        }
      ],
      "expectedEndEvent": "Event_End_Allocated"
    },
